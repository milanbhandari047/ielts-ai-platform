generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////////////////////////////////////////
// ENUMS
////////////////////////////////////////////////////

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
}

enum SubscriptionPlan {
  FREE
  PREMIUM
  INSTITUTION
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  TRIAL
}

enum TestType {
  ACADEMIC
  GENERAL
}

enum TestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MockTestStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE_NOT_GIVEN
  FILL_IN_THE_BLANK
  MATCH_HEADINGS
  MATCH_INFORMATION
  SHORT_ANSWER
  SENTENCE_COMPLETION
  SUMMARY_COMPLETION
  DIAGRAM_LABELLING
  NOTE_COMPLETION
}

enum WritingTask {
  TASK1
  TASK2
}

enum SpeakingPart {
  PART1
  PART2
  PART3
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  ESEWA
  KHALTI
}

enum NotificationType {
  RESULT_READY
  STREAK_REMINDER
  GOAL_ACHIEVED
  SUBSCRIPTION_EXPIRING
  NEW_TEST_AVAILABLE
  FEEDBACK_RECEIVED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

////////////////////////////////////////////////////
// USER SYSTEM
////////////////////////////////////////////////////

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String?
  avatar   String?
  role     Role    @default(STUDENT)

  // OAuth
  oauthProvider OAuthProvider?
  oauthId       String?

  targetBand   Float?
  streak       Int       @default(0)
  lastActiveAt DateTime?

  // Email verification
  emailVerified     Boolean   @default(false)
  emailVerifyToken  String?
  emailVerifyExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile      UserProfile?
  subscription Subscription?

  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]

  studyGoals StudyGoal[]

  readingAttempts     ReadingAttempt[]
  listeningAttempts   ListeningAttempt[]
  writingSubmissions  WritingSubmission[]
  speakingSubmissions SpeakingSubmission[]

  mockSessions MockTestSession[]

  analytics   UserAnalytics?
  bandHistory BandHistory[]

  notifications Notification[]

  vocabularyProgress VocabularyProgress[]
  savedWords         SavedWord[]

  aiSessions AiTutorSession[]

  communityPosts CommunityPost[]
  comments       CommunityComment[]

  payments Payment[]

  leaderboard LeaderboardEntry?

  @@map("users")
}

model SavedWord {
  id           String   @id @default(cuid())
  userId       String
  vocabularyId String
  notes        String?
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id])

  @@unique([userId, vocabularyId])
}

////////////////////////////////////////////////////
// AUTH
////////////////////////////////////////////////////

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique

  bio      String?
  country  String?
  phone    String?
  language String  @default("en")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique   // SHA-256 hash — never store raw token
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?           // null = active; set on logout / rotation

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique   // SHA-256 hash of the raw token
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

////////////////////////////////////////////////////
// SUBSCRIPTION
////////////////////////////////////////////////////

model Subscription {
  id     String @id @default(cuid())
  userId String @unique

  plan   SubscriptionPlan   @default(FREE)
  status SubscriptionStatus @default(TRIAL)

  startAt DateTime?
  endAt   DateTime?

  stripeCustomerId String?
  stripeSubId      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id     String @id @default(cuid())
  userId String

  amount   Float
  currency String @default("USD")

  status   PaymentStatus   @default(PENDING)
  provider PaymentProvider

  providerPaymentId String?
  metadata          Json?

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId String?

  @@map("payments")
}

////////////////////////////////////////////////////
// IELTS CORE MODELS
////////////////////////////////////////////////////

model StudyGoal {
  id     String @id @default(cuid())
  userId String

  targetBand   Float
  targetDate   DateTime
  dailyMinutes Int      @default(60)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("study_goals")
}

////////////////////////////////////////////////////
// READING
////////////////////////////////////////////////////

model ReadingTest {
  id     String     @id @default(cuid())
  title  String
  type   TestType   @default(ACADEMIC)
  status TestStatus @default(DRAFT)

  passages        ReadingPassage[]
  readingAttempts ReadingAttempt[]

  @@map("reading_tests")
}

model ReadingPassage {
  id      String @id @default(cuid())
  testId  String
  title   String
  content String

  test ReadingTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  questions ReadingQuestion[]

  @@map("reading_passages")
}

model ReadingQuestion {
  id        String @id @default(cuid())
  passageId String

  questionText  String
  questionType  QuestionType
  options       Json?
  correctAnswer String

  passage ReadingPassage @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@map("reading_questions")
}

model ReadingAttempt {
  id     String @id @default(cuid())
  userId String
  testId String

  score Int?
  band  Float?

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  test ReadingTest @relation(fields: [testId], references: [id])

  @@map("reading_attempts")
}

////////////////////////////////////////////////////
// LISTENING
////////////////////////////////////////////////////

model ListeningTest {
  id    String @id @default(cuid())
  title String

  sections          ListeningSection[]
  listeningAttempts ListeningAttempt[]

  @@map("listening_tests")
}

model ListeningSection {
  id       String @id @default(cuid())
  testId   String
  audioUrl String

  test ListeningTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  questions ListeningQuestion[]

  @@map("listening_sections")
}

model ListeningQuestion {
  id        String @id @default(cuid())
  sectionId String

  questionText  String
  correctAnswer String

  section ListeningSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("listening_questions")
}

model ListeningAttempt {
  id     String @id @default(cuid())
  userId String
  testId String

  score Int?
  band  Float?

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  test ListeningTest @relation(fields: [testId], references: [id])

  @@map("listening_attempts")
}

////////////////////////////////////////////////////
// WRITING
////////////////////////////////////////////////////

model WritingPrompt {
  id          String      @id @default(cuid())
  task        WritingTask
  title       String
  instruction String

  submissions WritingSubmission[]

  @@map("writing_prompts")
}

model WritingSubmission {
  id       String @id @default(cuid())
  userId   String
  promptId String

  essay     String
  wordCount Int

  overallBand  Float?
  taskResponse Float?
  coherence    Float?
  lexical      Float?
  grammar      Float?

  feedback Json?

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt WritingPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@map("writing_submissions")
}

////////////////////////////////////////////////////
// SPEAKING
////////////////////////////////////////////////////

model SpeakingCueCard {
  id          String       @id @default(cuid())
  part        SpeakingPart
  topic       String
  instruction String

  submissions SpeakingSubmission[]

  @@map("speaking_cue_cards")
}

model SpeakingSubmission {
  id        String @id @default(cuid())
  userId    String
  cueCardId String

  audioUrl   String
  transcript String?

  fluency       Float?
  pronunciation Float?
  grammar       Float?
  vocabulary    Float?

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cueCard SpeakingCueCard @relation(fields: [cueCardId], references: [id], onDelete: Cascade)

  @@map("speaking_submissions")
}

////////////////////////////////////////////////////
// MOCK TEST ENGINE
////////////////////////////////////////////////////

model MockTest {
  id    String @id @default(cuid())
  title String

  sessions MockTestSession[]

  @@map("mock_tests")
}

model MockTestSession {
  id         String @id @default(cuid())
  userId     String
  mockTestId String

  status MockTestStatus @default(IN_PROGRESS)

  readingScore   Float?
  listeningScore Float?
  writingScore   Float?
  speakingScore  Float?
  overallBand    Float?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mockTest MockTest @relation(fields: [mockTestId], references: [id])

  @@map("mock_test_sessions")
}

////////////////////////////////////////////////////
// VOCABULARY
////////////////////////////////////////////////////

model Vocabulary {
  id      String @id @default(cuid())
  word    String @unique
  meaning String

  progress   VocabularyProgress[]
  savedWords SavedWord[]

  @@map("vocabulary")
}

model VocabularyProgress {
  id           String @id @default(cuid())
  userId       String
  vocabularyId String

  correctCount Int @default(0)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@unique([userId, vocabularyId])
  @@map("vocabulary_progress")
}

////////////////////////////////////////////////////
// ANALYTICS
////////////////////////////////////////////////////

model UserAnalytics {
  id     String @id @default(cuid())
  userId String @unique

  readingBand   Float?
  listeningBand Float?
  writingBand   Float?
  speakingBand  Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_analytics")
}

model BandHistory {
  id     String @id @default(cuid())
  userId String

  overall Float?
  source  String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("band_history")
}

////////////////////////////////////////////////////
// AI TUTOR
////////////////////////////////////////////////////

model AiTutorSession {
  id     String @id @default(cuid())
  userId String

  title String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_tutor_sessions")
}

////////////////////////////////////////////////////
// NOTIFICATIONS
////////////////////////////////////////////////////

model Notification {
  id     String @id @default(cuid())
  userId String

  type    String
  title   String
  message String
  isRead  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

////////////////////////////////////////////////////
// COMMUNITY
////////////////////////////////////////////////////

model CommunityPost {
  id     String @id @default(cuid())
  userId String

  title   String
  content String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("community_posts")
}

model CommunityComment {
  id     String @id @default(cuid())
  postId String
  userId String

  content String
  user    User   @relation(fields: [userId], references: [id])

  @@map("community_comments")
}

////////////////////////////////////////////////////
// LEADERBOARD
////////////////////////////////////////////////////

model LeaderboardEntry {
  id     String @id @default(cuid())
  userId String @unique

  weeklyScore Float @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("leaderboard_entries")
}

////////////////////////////////////////////////////
// BLOG
////////////////////////////////////////////////////

model BlogPost {
  id      String @id @default(cuid())
  title   String
  slug    String @unique
  content String

  @@map("blog_posts")
}

////////////////////////////////////////////////////
// AI USAGE
////////////////////////////////////////////////////

model AiTokenUsage {
  id      String  @id @default(cuid())
  userId  String?
  feature String
  model   String
  tokens  Int     @default(0)

  createdAt DateTime @default(now())

  @@map("ai_token_usage")
}
